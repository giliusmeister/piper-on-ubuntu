PIPER_API_KEY=local-dev-key
PYTHON_BIN=python3
PIPER_DEFAULT_LANGUAGE=en
PIPER_MODEL_DIR=/opt/piper/models
PIPER_VOICE_MAP_PATH=/opt/piper/models/openlingo_voices.json
PIPER_BIN=/opt/piper-openai-api/.venv/bin/piper
FFMPEG_BIN=/usr/bin/ffmpeg
PIPER_SENTENCE_SILENCE=0.4
PIPER_HOST=127.0.0.1
PIPER_PORT=8099
PIPER_TIMEOUT_SECONDS=60
PIPER_TTS_MAX_CONCURRENT=1
ENABLE_PIPER_MONITOR=1
PIPER_MONITOR_INTERVAL=1min
PIPER_MONITOR_RANDOMIZED_DELAY=10s
PIPER_MONITOR_TIMEOUT_SECONDS=10
PIPER_MONITOR_MIN_AVAILABLE_MB=512

LAN_HOST=192.168.11.11
NGINX_API_PORT=8100
NGINX_ALLOW_CIDR=100.65.0.0/16

NGINX_ALLOW_IPV6_CIDR=
CONFIGURE_NGINX=snippet
ENABLE_TLS=0
TLS_CERT_PATH=/etc/nginx/tls/piper-openai-api/fullchain.pem
TLS_KEY_PATH=/etc/nginx/tls/piper-openai-api/privkey.pem
ENABLE_CERT_SYNC=0
CERT_SYNC_INTERVAL=15min
CERT_SYNC_RANDOMIZED_DELAY=2min
CERT_SYNC_RELOAD_NGINX=1

# Optional certificate source settings. Keep real values in local .env only.
NETBIRD_CERT_SOURCE_URL=
NETBIRD_CERT_FULLCHAIN_URL=
NETBIRD_CERT_PRIVKEY_URL=
NETBIRD_CERT_BASIC_AUTH_USER=
NETBIRD_CERT_BASIC_AUTH_PASSWORD=
NETBIRD_CERT_SOURCE_HOST=
NETBIRD_CERT_SOURCE_USER=root
NETBIRD_CERT_SOURCE_DIR=
NETBIRD_CERT_FULLCHAIN_PATH=
NETBIRD_CERT_PRIVKEY_PATH=
